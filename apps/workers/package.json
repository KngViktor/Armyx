{
  "name": "@armyx/workers",
  "version": "1.0.0",
  "private": true,
  "description": "BullMQ background workers: submissions, drafts, notifications, PDF slips, exports, document checks",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.spec.js"
  },
  "dependencies": {
    "@armyx/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1145.0",
    "bullmq": "^5.81.5",
    "exceljs": "^4.4.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "assets"
  ]
}
