{
  "name": "armyx",
  "private": true,
  "description": "Nigerian Army official website and online recruitment portal (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:shared": "pnpm --filter @armyx/shared build",
    "dev:api": "pnpm --filter @armyx/api dev",
    "dev:workers": "pnpm --filter @armyx/workers dev",
    "dev:web": "pnpm --filter @armyx/web dev",
    "dev:cms": "pnpm --filter @armyx/cms dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @armyx/api db:migrate",
    "db:seed": "pnpm --filter @armyx/api db:seed",
    "cms:seed": "pnpm --filter @armyx/cms seed"
  }
}
