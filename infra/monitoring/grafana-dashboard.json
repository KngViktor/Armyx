{
  "title": "Armyx — Recruitment Portal",
  "uid": "armyx-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus" }] },
  "panels": [
    { "type": "stat", "title": "Requests / s", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(rate(armyx_http_requests_total[1m]))" }] },
    { "type": "stat", "title": "5xx rate", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }, "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum(rate(armyx_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(armyx_http_requests_total[5m]))" }] },
    { "type": "stat", "title": "API pods", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "count(up{job=~\".*api.*\"} == 1)" }] },
    { "type": "stat", "title": "Submission backlog", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "max(armyx_queue_depth{queue=\"submissions\"})" }] },
    { "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(armyx_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(armyx_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(armyx_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }] },
    { "type": "timeseries", "title": "Requests by route", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "topk(10, sum by (route) (rate(armyx_http_requests_total[5m])))", "legendFormat": "{{route}}" }] },
    { "type": "timeseries", "title": "Queue depth", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "max by (queue) (armyx_queue_depth)", "legendFormat": "{{queue}}" }] },
    { "type": "timeseries", "title": "Load shed / in-flight", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(armyx_http_shed_total[1m]))", "legendFormat": "shed/s" },
        { "expr": "sum(armyx_http_inflight)", "legendFormat": "in-flight" }] },
    { "type": "timeseries", "title": "PgBouncer waiting clients", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (database) (pgbouncer_pools_client_waiting_connections)", "legendFormat": "{{database}}" }] },
    { "type": "timeseries", "title": "Job throughput", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (queue, result) (rate(armyx_jobs_total[5m]))", "legendFormat": "{{queue}} {{result}}" }] }
  ]
}
