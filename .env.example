# =============================================================================
# Armyx — environment variables (copy to .env for local development).
# In Kubernetes these come from Secrets/ConfigMaps (see infra/k8s). Never
# commit real values. Generate keys with:  openssl rand -base64 32
# =============================================================================

NODE_ENV=development

# ---------------------------------------------------------------- web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser reaches the API. In production the API is served on the
# same origin under /api/v1 (Cloudflare / ingress path routing).
NEXT_PUBLIC_API_BASE=/api/v1
# Server-side only: where Next.js proxies /api/v1 in development.
API_INTERNAL_URL=http://localhost:4000
# Payload CMS public URL (used at build time / ISR to fetch content).
CMS_URL=http://localhost:3001
# Shared secret the CMS uses to trigger on-demand revalidation of static pages.
REVALIDATE_SECRET=change-me-revalidate-secret
# Cloudflare Turnstile site key (public). Leave empty locally to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------- api
PORT=4000
METRICS_PORT=9464
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Via PgBouncer in production (transaction pooling).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/armyx
DATABASE_REPLICA_URL=postgres://postgres:postgres@127.0.0.1:5433/armyx
# Direct primary connection for migrations (advisory locks need session pooling).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/armyx
DB_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379
# Production: comma-separated Redis Cluster nodes, e.g. redis-0:6379,redis-1:6379
REDIS_CLUSTER_NODES=
SESSION_COOKIE=sid
COOKIE_SECURE=false
TURNSTILE_SECRET=
MAX_INFLIGHT=400
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
IP_HASH_SALT=change-me-to-a-long-random-string

# Field-level encryption (AES-256-GCM). "version:base64key" pairs, comma separated.
DATA_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
DATA_ENCRYPTION_KEY_VERSION=1
BLIND_INDEX_KEY=REPLACE_WITH_openssl_rand_base64_32

# Test/staging only: fixes every OTP to this value. The API refuses to start in production if set.
OTP_FIXED_CODE=

# ---------------------------------------------------------------- object storage (S3 compatible)
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=armyx-documents
S3_ACCESS_KEY_ID=armyx
S3_SECRET_ACCESS_KEY=armyx-secret
S3_FORCE_PATH_STYLE=true
# Server-side encryption header (AES256 | aws:kms). Leave empty ONLY for local stores without SSE support.
S3_SSE=AES256

# ---------------------------------------------------------------- workers
WORKER_QUEUES=submissions,drafts,notifications,pdf,exports,documents,contact,maintenance
WORKER_CONCURRENCY=10
WORKER_METRICS_PORT=9465
CONTACT_DESK_EMAIL=info@army.mil.ng
# Email (SMTP). Use Mailpit locally (http://localhost:8025).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Nigerian Army Recruitment <no-reply@army.mil.ng>"
# SMS provider: console | termii | generic-http
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=NIGARMY

# ---------------------------------------------------------------- cms (Payload)
PAYLOAD_SECRET=change-me-payload-secret
CMS_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/armyx_cms
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------- seed (dev/staging only)
SEED_APPLICANTS=2000
SEED_ADMIN_PASSWORD="ChangeMe!Army2026"
SEED_APPLICANT_PASSWORD="Applicant#2026"
